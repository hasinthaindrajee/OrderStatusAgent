OPENAI_API_KEY=your-openai-api-key-here
# AGENT_OPENAI_API_KEY takes priority over OPENAI_API_KEY if set — use it
# as an override when a platform manages/injects OPENAI_API_KEY itself.
# AGENT_OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_URL=https://api.openai.com/v1
PORT=8000
# LOG_LEVEL=DEBUG
